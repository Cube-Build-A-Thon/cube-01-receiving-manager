# ==============================================================================
# Cube Buildathon · 01 · Receiving Manager
# Environment Configuration Template (Placeholders only — NEVER commit actual secrets)
# ==============================================================================

# Multimodal Vision Model Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
VISION_MODEL_NAME=gemini-2.0-flash
BATCH_MODEL_NAME=Gemini-3.6-Vision-Batch

# Server & Network Configuration
HOST=127.0.0.1
PORT=8000
VITE_API_BASE_URL=http://localhost:8000

# Tenancy & Security (Multi-Tenant Row Level Security)
DEFAULT_ORG_ID=org_demo_alpha
TEST_TENANT_ORG_ID=org_demo_bravo
ENABLE_STRICT_RLS=true

# Operational & Fail-Open Thresholds
FAIL_OPEN_TIMEOUT_SECONDS=5.0
BATCH_EXECUTION_MAX_LATENCY_MS=2500
MIN_VISUAL_CLARITY_THRESHOLD=0.40
UNCERTAIN_CONFIDENCE_CEILING=0.50
